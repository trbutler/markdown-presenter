use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Presenter::Output;

my $a = {id => 'a', line1 => 'Original', enterMs => 1200, exitMs => 1200, holdMs => 10000};
my $b = {%$a, id => 'b'};
my $c = {%$a, id => 'c'};
my $o = Presenter::Output->new;
is $o->snapshot(0)->{phase}, 'hidden', 'starts hidden';
$o->command('trigger', $a, 100);
is $o->snapshot(100)->{phase}, 'entering', 'first tap enters';
$a->{line1} = 'Edited';
is $o->snapshot(200)->{run}{cue}{line1}, 'Original', 'active content is a snapshot';
$o->tick(1300);
is $o->snapshot(1300)->{phase}, 'holding', 'hold begins after build-in';
is $o->snapshot(1300)->{run}{exitAt}, 11300, 'hold excludes animation';
$o->tick(11300);
is $o->snapshot(11300)->{phase}, 'exiting', 'automatic exit';
$o->tick(12500);
is $o->snapshot(12500)->{phase}, 'hidden', 'automatic completion';

$o->command('trigger', $a, 20000);
$o->command('trigger', $a, 20600);
is $o->snapshot(20600)->{phase}, 'exiting', 'second tap interrupts entry';
is $o->snapshot(20600)->{run}{exitFrom}, .5, 'exit continues from partial entry';
$o->command('trigger', $b, 20700);
$o->command('trigger', $c, 20800);
is $o->snapshot(20800)->{pending}{id}, 'c', 'latest replacement wins';
$o->tick(21799);
is $o->snapshot(21799)->{run}{cue}{id}, 'a', 'replacement waits for exit';
$o->tick(21800);
$o->tick(22000);
is $o->snapshot(22000)->{run}{cue}{id}, 'c', 'replacement enters after exit';
is $o->snapshot(22000)->{run}{startedAt}, 21800, 'replacement starts at first tick after completion';
my $started = $o->snapshot(22000)->{run}{startedAt};
$o->command('show', $c, 22100);
is $o->snapshot(22100)->{run}{startedAt}, $started, 'show is idempotent';
$o->command('trigger', $b, 22200);
$o->command('clear', undef, 22300);
$o->tick(50000);
is $o->snapshot(50000)->{phase}, 'hidden', 'clear cancels pending lifecycle';
ok !$o->snapshot(50000)->{pending}, 'clear removes replacement';

$o->command('trigger', $a, 60000);
$o->command('trigger', $b, 62000);
$o->command('hide', undef, 62100);
$o->tick(70000);
is $o->snapshot(70000)->{phase}, 'hidden', 'hide cancels pending replacement';
done_testing;
